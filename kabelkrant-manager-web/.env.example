# OBS WebSocket Configuration
OBS_WEBSOCKET_URL=ws://localhost:4455
OBS_WEBSOCKET_PASSWORD=rtvserver

# Data storage path (for settings.json and hasPlayed.json)
DATA_PATH=./data

# Base path for video files (for server-side file browser)
VIDEO_BASE_PATH=/videos

# Server port
PORT=3000

# Optional: Sentry DSN for error tracking
# SENTRY_DSN=
